# Copy via: fiver --init
# Path: ~/.config/fiver/fiver.conf

WINDOW_TITLE=fiver
MAX_SIZE=1280
BITRATE=8M
MAX_FPS=60
STAY_AWAKE=true
TURN_SCREEN_OFF=false
SHOW_TOUCHES=true
AUDIO=true
ALWAYS_ON_TOP=false
FULLSCREEN=false

ADB_PORT=5555
PREFER_WIRELESS=true
POLL_INTERVAL=1.5
RECONNECT_MIN=1.0
RECONNECT_MAX=20.0
AUTHORIZE_TIMEOUT=180
# DEVICE_SERIAL=
# PHONE_IP=

# ADB_PATH=adb
# SCRCPY_PATH=scrcpy

LOG_LEVEL=info
